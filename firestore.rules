rules_version = '2';

// Regras de segurança do Controle de Gastos.
// Princípio: cada pessoa só acessa o próprio perfil e o cofre
// da família da qual é membro. Todo o resto é negado.
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil: só o próprio dono lê e escreve.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /familias/{familiaId} {

      // Ler o cofre: só membros.
      allow read: if request.auth != null
        && request.auth.uid in resource.data.membros;

      // Criar família: precisa estar logado e se incluir como membro.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.membros;

      // Atualizar: membros podem tudo; quem não é membro só pode
      // uma coisa — adicionar o PRÓPRIO uid em membros (entrar com código),
      // sem tocar em nenhum outro campo e sem remover ninguém.
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.membros
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
          && request.resource.data.membros.toSet().hasAll(resource.data.membros.toSet())
          && request.resource.data.membros.toSet().difference(resource.data.membros.toSet())
             == [request.auth.uid].toSet()
        )
      );

      // Apagar uma família inteira: nunca pelo app.
      allow delete: if false;

      // Transações: qualquer membro da família lê, lança, edita e exclui.
      match /transacoes/{transacaoId} {
        allow read, update, delete: if ehMembro(database, familiaId);
        allow create: if ehMembro(database, familiaId)
          && request.resource.data.valorCentavos is int
          && request.resource.data.valorCentavos > 0;
      }

      // Orçamentos: limite mensal por categoria (id do doc = categoria).
      match /orcamentos/{categoria} {
        allow read, delete: if ehMembro(database, familiaId);
        allow create, update: if ehMembro(database, familiaId)
          && request.resource.data.limiteCentavos is int
          && request.resource.data.limiteCentavos > 0;
      }
    }

    function ehMembro(database, familiaId) {
      return request.auth != null
        && request.auth.uid in
           get(/databases/$(database)/documents/familias/$(familiaId)).data.membros;
    }
  }
}
