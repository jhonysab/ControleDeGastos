# Modelo do arquivo de assinatura do release.
#
# COPIE este arquivo para "keystore.properties" (sem .exemplo) e
# preencha com os SEUS valores. O keystore.properties de verdade fica
# fora do git (já está no .gitignore) — ele guarda suas senhas.
#
# storeFile é relativo à raiz do projeto (onde fica este arquivo).

storeFile=unicka-release.jks
storePassword=COLOQUE_SUA_SENHA_DO_KEYSTORE
keyAlias=unicka
keyPassword=COLOQUE_SUA_SENHA_DA_CHAVE
